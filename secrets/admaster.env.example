# Site logins for the ad master's browser (dotenv format).
#
# The model only ever sees these NAMES. When it fills a login form it types e.g. OLX_PASSWORD;
# the browser server swaps in the real value and redacts it from anything sent back to the model.
#
# Store the real file at /root/agent-secrets/admaster.env on the OMV host:
#   mkdir -p /root/agent-secrets && chmod 700 /root/agent-secrets
#   nano /root/agent-secrets/admaster.env
#   chmod 400 /root/agent-secrets/admaster.env
#
# Use passwords that are unique to these sites. Do NOT put 2FA/TOTP seeds here:
# the agent should ask you for codes instead.

OLX_EMAIL=you@example.com
OLX_PASSWORD=change-me
VINTED_EMAIL=you@example.com
VINTED_PASSWORD=change-me
