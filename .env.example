# Created and filled in by install.sh. Keep this file private (chmod 600).

# Auth: set ONE of these.
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` and uses your Pro/Max plan limits.
# ANTHROPIC_API_KEY comes from console.anthropic.com and is billed per token.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Chat UI (http://<server>:UI_PORT). install.sh generates a password.
UI_PASSWORD=
UI_PORT=8090
UI_BIND=0.0.0.0

# uid/gid of the "claude-agents" system user
AGENT_UID=
AGENT_GID=
DATA_DIR=/opt/claude-agents-data
TZ=Europe/Lisbon
AGENTS_SUBNET=172.30.0.0/24

# Optional browser agent: set COMPOSE_PROFILES=browser to start it
COMPOSE_PROFILES=
BROWSER_ALLOWED_ORIGINS=https://www.olx.pt

# Resource limits
AGENTS_CPUS=1.5
AGENTS_MEMORY=1g
BROWSER_CPUS=2.0
BROWSER_MEMORY=1g
