[Unit]
Description=Block claude-agents containers from the local network
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/claude-agents/firewall.env
ExecStart=/usr/local/sbin/claude-agents-firewall ${AGENTS_SUBNET}
ExecStop=/usr/local/sbin/claude-agents-firewall --remove ${AGENTS_SUBNET}

[Install]
WantedBy=multi-user.target
